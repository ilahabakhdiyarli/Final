{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "bill-payment-list",
  "description": "GET /bill-payments 200",
  "type": "object",
  "required": [
    "page",
    "limit",
    "total",
    "totalPages",
    "items"
  ],
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "totalPages": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "receiptNo",
          "billerId",
          "subscriberNo",
          "amount",
          "fee",
          "total",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^bpm_[a-z0-9]{8}$"
          },
          "receiptNo": {
            "type": "string",
            "pattern": "^RCP-[0-9]{8}-[0-9]{6}$"
          },
          "billerId": {
            "type": "string"
          },
          "subscriberNo": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "fee": {
            "type": "number",
            "minimum": 0
          },
          "total": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS"
            ]
          },
          "createdAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          }
        }
      }
    }
  }
}
