{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "card",
  "description": "POST /cards 201, GET /cards/{id} 200",
  "type": "object",
  "required": [
    "id",
    "accountId",
    "label",
    "maskedPan",
    "expiry",
    "currency",
    "status",
    "availableBalance",
    "limits",
    "blockReason",
    "blockedAt",
    "createdAt",
    "spentToday"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^vcd_[a-z0-9]{8}$"
    },
    "accountId": {
      "type": "string",
      "pattern": "^acc_[0-9]+$"
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "maskedPan": {
      "type": "string",
      "pattern": "^4169 73[*]{2} [*]{4} [0-9]{4}$"
    },
    "expiry": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-2])/[0-9]{2}$"
    },
    "currency": {
      "type": "string",
      "enum": [
        "AZN",
        "USD",
        "EUR"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "FROZEN",
        "BLOCKED"
      ]
    },
    "availableBalance": {
      "type": "number",
      "minimum": 0
    },
    "limits": {
      "type": "object",
      "required": [
        "dailyOnline",
        "perTransaction"
      ],
      "properties": {
        "dailyOnline": {
          "type": "number"
        },
        "perTransaction": {
          "type": "number"
        }
      }
    },
    "blockReason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "TEMPORARY",
        "LOST",
        "STOLEN",
        null
      ]
    },
    "blockedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "spentToday": {
      "type": "number",
      "minimum": 0
    }
  }
}
