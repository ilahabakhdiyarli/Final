{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "bill-payment",
  "description": "POST /bill-payments 201/200",
  "type": "object",
  "required": [
    "id",
    "receiptNo",
    "status",
    "biller",
    "subscriberNo",
    "amount",
    "fee",
    "total",
    "currency",
    "cardId",
    "balanceAfter",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bpm_[a-z0-9]{8}$"
    },
    "receiptNo": {
      "type": "string",
      "pattern": "^RCP-[0-9]{8}-[0-9]{6}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS"
      ]
    },
    "biller": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "UTILITY",
            "MOBILE",
            "INTERNET"
          ]
        }
      }
    },
    "subscriberNo": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true
    },
    "fee": {
      "type": "number",
      "minimum": 0
    },
    "total": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "enum": [
        "AZN",
        "USD",
        "EUR"
      ]
    },
    "cardId": {
      "type": "string",
      "pattern": "^vcd_[a-z0-9]{8}$"
    },
    "balanceAfter": {
      "type": "number",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
