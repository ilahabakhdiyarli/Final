{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "beneficiary",
  "description": "POST /beneficiaries 201",
  "type": "object",
  "required": [
    "id",
    "fullName",
    "iban",
    "ibanMasked",
    "currency",
    "nickname",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ben_[a-z0-9]{8}$"
    },
    "fullName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50
    },
    "iban": {
      "type": "string",
      "pattern": "^AZ[0-9]{2}[A-Z]{4}[A-Z0-9]{20}$"
    },
    "ibanMasked": {
      "type": "string",
      "pattern": "^AZ[0-9]{2} [*]{4} [*]{4} [*]{4} [*]{4} [A-Z0-9]{4}$"
    },
    "currency": {
      "type": "string",
      "enum": [
        "AZN",
        "USD",
        "EUR"
      ]
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
