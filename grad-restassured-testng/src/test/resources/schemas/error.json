{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "error",
  "description": "Biznes xətaları 4xx: { error, code }",
  "type": "object",
  "required": [
    "error",
    "code"
  ],
  "properties": {
    "error": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z_]+$"
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
